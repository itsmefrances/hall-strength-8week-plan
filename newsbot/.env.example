# --- Required to publish ---
OPENAI_API_KEY=sk-...
IG_ACCESS_TOKEN=EAAG...            # long-lived Page/system-user token with instagram_content_publish
IG_USER_ID=17841400000000000       # Instagram Business account ID (not the username)

# --- Image hosting (defaults come from GitHub Actions automatically) ---
# IMAGE_HOST_GITHUB_TOKEN=ghp_...  # only needed when running outside Actions
# IMAGE_HOST_GITHUB_REPO=owner/repo
# IMAGE_HOST_GITHUB_BRANCH=main

# --- Optional ---
# SITE_URL=https://www.ilovetheupperwestside.com
# FEED_URL=https://www.ilovetheupperwestside.com/feed/
# OPENAI_MODEL=gpt-4o-mini
# BRAND_NAME=UWS News Daily
# ACCENT_COLOR=#C4472F
# LOGO_PATH=newsbot/assets/logo.png
# DRY_RUN=false
# REQUIRE_APPROVAL=false           # queue posts for review instead of auto-publishing
# SEED_ON_FIRST_RUN=true
# MAX_POSTS_PER_RUN=2
